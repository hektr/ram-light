{
  "manifest_version": 3,
  "name": "RAM Light",
  "version": "2.0.1",
  "description": "Real-time monitor of free RAM.",
  "author": "hektr992",
  "homepage_url": "https://github.com/hektr/ram-light",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "system.memory"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
