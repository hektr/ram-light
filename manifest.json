{
  "manifest_version": 3,
  "name": "RAM Light",
  "version": "2.3.1",
  "description": "Real-time monitor of free RAM",
  "author": "hektr992",
  "homepage_url": "https://github.com/hektr/ram-light",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "system.memory",
    "tabs",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
